# Application
NODE_ENV=development
PORT=3000
# Lista separada por virgula; espacos em volta sao ignorados.
# Vale tambem para o handshake do WebSocket em /realtime: origem fora da lista e
# recusada no upgrade (ver src/realtime/realtime-io.adapter.ts). O modulo de
# realtime nao tem variavel propria — a porta e a mesma do HTTP (PORT).
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# Numero de proxies confiaveis na frente da app (0/vazio = nenhum, 1 = ALB/ingress
# unico). Necessario para o rate limit por IP funcionar atras de proxy. Nao ligue
# sem proxy na frente: permite spoof de X-Forwarded-For.
TRUST_PROXY_HOPS=0
# Sobe a doc Swagger em /api/docs. Deixe vazio/ausente fora do ambiente local:
# as rotas do Swagger ficam fora do pipeline de guards e expoem o contrato
# completo da API sem autenticacao.
ENABLE_SWAGGER=true

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=template_db
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT=30000

# Redis (BullMQ)
# Conexao usada pelas filas e pelo health check em GET /api/health. Porta
# invalida (texto, 0, negativa) cai no padrao 6379. Deixe REDIS_PASSWORD vazio
# quando o servidor nao pede AUTH: para o ioredis string vazia e o mesmo que
# nao definir (o comando AUTH nao e enviado).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SuperTokens
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=
SUPERTOKENS_APP_NAME=MyApp
SUPERTOKENS_API_DOMAIN=http://localhost:3000
SUPERTOKENS_WEBSITE_DOMAIN=http://localhost:3001
# O SuperTokens deriva as configuracoes de cookie de SUPERTOKENS_API_DOMAIN e
# SUPERTOKENS_WEBSITE_DOMAIN, entao os dois precisam refletir o deployment.
# Em setups cross-site o SDK aplica automaticamente SameSite=None + Secure e
# protecao CSRF via header customizado.

# SuperAdmin — comma-separated SuperTokens user IDs
SUPERADMIN_SUPERTOKENS_IDS=

# AWS S3 / LocalStack
# Upload aceita no maximo 10MB e apenas os tipos da allowlist (jpeg, png, webp,
# pdf); imagens sao convertidas para WebP e ganham uma miniatura. GIF fica de
# fora porque nao passa pelo reencode em WebP (ver ALLOWED_MIME_TYPES em
# src/storage/storage.controller.ts).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=template-files
AWS_S3_ENDPOINT=http://localhost:4566
SIGNED_URL_EXPIRY_SECONDS=900

# OpenTelemetry (leave empty to disable in dev)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=my-app-api

# Logging
LOG_LEVEL=debug

# Throttling
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Anti-bot
# O modulo sobe sempre (publica GET /api/v1/anti-bot/*), mas nenhuma rota
# existente ganha checagem por isso: as camadas entram por `@AntiBot()` na rota.
#
# Chave HMAC dos form tokens. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem valor, a app usa uma chave aleatoria por processo e AVISA no log: os tokens
# param de valer no restart e nao valem entre instancias. Obrigatorio em
# producao com mais de uma replica.
ANTI_BOT_TOKEN_SECRET=
# Tempo minimo (ms) entre renderizar e enviar o formulario. Abaixo disso a
# submissao e tratada como script e recebe um sucesso falso. A idade sai do `iat`
# assinado do form token, nao do relogio do cliente.
ANTI_BOT_MIN_TIME_MS=2000
# Idade maxima (ms) do formulario. Vale para o TimingGuard e para o `exp` do form
# token — um valor so, para os dois nao divergirem.
ANTI_BOT_MAX_TIME_MS=1800000
# Store compartilhado dos form tokens usados. Este template NAO traz adapter
# Redis: definir esta variavel hoje NAO liga nada — so registra um aviso no boot
# lembrando que o uso unico continua valendo por processo. O passo a passo do
# adapter esta em src/anti-bot/infrastructure/persistence/token-store.provider.ts.
# Nao ha fallback para REDIS_URL: essa variavel pertence a fila/cache.
ANTI_BOT_REDIS_URL=
# Cloudflare Turnstile. Com TURNSTILE_ENABLED diferente de `true` o TurnstileGuard
# passa direto (inclusive nas rotas de recuperacao de senha, onde ele ja esta
# aplicado). Ligue e as duas chaves passam a ser obrigatorias.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comportamento quando a Cloudflare esta inacessivel: `true` (default) libera a
# requisicao, `false` rejeita. `false` e mais seguro e menos disponivel — quem
# consegue bloquear a chamada de verificacao burla o captcha no modo aberto.
TURNSTILE_FAIL_OPEN=true
# Feature flags por tenant
# Cache in-memory POR PROCESSO das flags. A invalidacao no PUT de features so
# vale para a instancia que atendeu a requisicao: com varias replicas, as outras
# continuam servindo o valor antigo ate o TTL vencer. O TTL curto e a garantia,
# nao a invalidacao. Use 0 para desligar o cache (volta a consultar o banco a
# cada checagem de @RequiresFeature).
TENANT_FEATURE_CACHE_TTL_MS=30000
# Teto de tenants guardados; a entrada mais antiga sai quando estoura.
TENANT_FEATURE_CACHE_MAX_TENANTS=1000
