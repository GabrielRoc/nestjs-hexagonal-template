# Application
NODE_ENV=development
PORT=3000
# Lista separada por virgula; espacos em volta sao ignorados.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# Numero de proxies confiaveis na frente da app (0/vazio = nenhum, 1 = ALB/ingress
# unico). Necessario para o rate limit por IP funcionar atras de proxy. Nao ligue
# sem proxy na frente: permite spoof de X-Forwarded-For.
TRUST_PROXY_HOPS=0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=template_db
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT=30000

# SuperTokens
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=
SUPERTOKENS_APP_NAME=MyApp
SUPERTOKENS_API_DOMAIN=http://localhost:3000
SUPERTOKENS_WEBSITE_DOMAIN=http://localhost:3001
# O SuperTokens deriva as configuracoes de cookie de SUPERTOKENS_API_DOMAIN e
# SUPERTOKENS_WEBSITE_DOMAIN, entao os dois precisam refletir o deployment.
# Em setups cross-site o SDK aplica automaticamente SameSite=None + Secure e
# protecao CSRF via header customizado.

# SuperAdmin — comma-separated SuperTokens user IDs
SUPERADMIN_SUPERTOKENS_IDS=

# AWS S3 / LocalStack
# Upload aceita no maximo 10MB e apenas os tipos da allowlist (jpeg, png, gif,
# webp, pdf); imagens sao convertidas para WebP e ganham uma miniatura.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=template-files
AWS_S3_ENDPOINT=http://localhost:4566
SIGNED_URL_EXPIRY_SECONDS=900

# OpenTelemetry (leave empty to disable in dev)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=my-app-api

# Logging
LOG_LEVEL=debug

# Throttling
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
