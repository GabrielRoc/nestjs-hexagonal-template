# Variaveis consumidas por infra/docker-compose.yml (producao).
#
# Este arquivo NAO substitui o .env.example da raiz (que e o do ambiente de
# desenvolvimento local). No servidor:
#
#   cp infra/.env.example /opt/app/.env && chmod 600 /opt/app/.env
#
# e preencha os valores. Tudo marcado como OBRIGATORIO esta declarado no compose
# como ${VAR:?mensagem}: se faltar, `docker compose up` falha na hora com o
# motivo, em vez de subir com um default silencioso.

# --- Imagem da aplicacao (OBRIGATORIO) ---------------------------------------
# Reescrito a cada deploy pelo workflow com a tag imutavel do commit
# (<repo>:<sha>). Nunca aponte para uma tag movel como :latest -- restart do
# container passaria a puxar outra build.
API_IMAGE=000000000000.dkr.ecr.us-east-1.amazonaws.com/minha-app:sha-do-commit

# --- Banco de dados (OBRIGATORIOS) -------------------------------------------
# Usados tanto pelo container do Postgres quanto pela app. DB_HOST/DB_PORT nao
# aparecem aqui: sao fixos no compose (postgres:5432, rede interna).
DB_USERNAME=postgres
# Use apenas alfanumericos: esta senha tambem e interpolada na
# POSTGRESQL_CONNECTION_URI do SuperTokens, e `@ : / ? # %` quebram o parsing da
# URI (o core tenta conectar no host errado). Vale para qualquer valor deste
# arquivo: um ` #` (espaco + cerquilha) no meio do valor inicia comentario e o
# compose TRUNCA a partir dali, sem avisar.
DB_PASSWORD=troque-esta-senha
DB_DATABASE=app_db
# Pool do pg por processo. Valor invalido ou <= 0 cai no default.
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT=30000

# --- SuperTokens -------------------------------------------------------------
# OBRIGATORIO: protege o core na rede interna e e enviado pela app.
SUPERTOKENS_API_KEY=troque-esta-chave
SUPERTOKENS_APP_NAME=MyApp
# OBRIGATORIOS: os nomes lidos por src/config/supertokens.config.ts. Precisam
# ser as URLs publicas reais (com https://) -- sao elas que definem o dominio do
# cookie de sessao. Errar aqui quebra login em producao sem erro visivel.
SUPERTOKENS_API_DOMAIN=https://api.exemplo.com.br
SUPERTOKENS_WEBSITE_DOMAIN=https://app.exemplo.com.br
# IDs do SuperTokens com papel SUPERADMIN, separados por virgula.
SUPERADMIN_SUPERTOKENS_IDS=

# --- HTTP / borda ------------------------------------------------------------
# OBRIGATORIO: origens permitidas no CORS, separadas por virgula.
CORS_ORIGINS=https://app.exemplo.com.br
# Numero de proxies na frente da app. Com o Caddy desta stack: 1.
TRUST_PROXY_HOPS=1
# OBRIGATORIO: dominio publico servido pelo Caddy (sem esquema).
CADDY_DOMAIN=api.exemplo.com.br
# OBRIGATORIO: e-mail da conta ACME (avisos de expiracao do Let's Encrypt).
CADDY_ACME_EMAIL=admin@exemplo.com.br

# --- AWS / S3 ----------------------------------------------------------------
# As credenciais NAO vao no .env: o SDK usa a role da instancia EC2 via IMDS.
AWS_REGION=us-east-1
# Vazio desativa o check de storage no /api/health (deploy sem S3 continua 200).
AWS_S3_BUCKET=
# Vazio = S3 real; preencha apenas para MinIO/LocalStack.
AWS_S3_ENDPOINT=
SIGNED_URL_EXPIRY_SECONDS=900

# --- Observabilidade ---------------------------------------------------------
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=app-api

# --- Rate limit --------------------------------------------------------------
# In-memory por processo: com mais de uma replica o limite efetivo e
# THROTTLE_LIMIT x numero de processos.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ENABLE_SWAGGER nao entra aqui de proposito: as rotas do Swagger ficam fora do
# pipeline de guards e publicariam o contrato completo da API sem autenticacao.
